<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rulesets – OoT Randomizer Async Weekly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'media',
            theme: { extend: { fontFamily: { cinzel: ['Cinzel', 'serif'] } } }
        }
    </script>
    <style>
        :root {
            --body-bg: #faf7f0;
            --body-glow: radial-gradient(ellipse 80% 40% at 50% -5%, #fef3c7 0%, transparent 70%);
            --gold-stop: rgba(180, 83, 9, 0.45);
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --body-bg: #0d0e1a;
                --body-glow: radial-gradient(ellipse 80% 40% at 50% -5%, #1e1040 0%, transparent 70%);
                --gold-stop: rgba(217, 119, 6, 0.5);
            }
        }
        body { background-color: var(--body-bg); background-image: var(--body-glow); }
        .gold-line {
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold-stop), transparent);
        }
    </style>
</head>

<body class="min-h-screen font-sans text-gray-900 dark:text-gray-100 transition-colors duration-300">

    <nav class="sticky top-0 z-10 backdrop-blur-md bg-amber-50/80 dark:bg-black/50 border-b border-amber-200 dark:border-amber-800/30 transition-colors duration-300">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="font-cinzel text-xl font-bold tracking-widest text-amber-700 dark:text-amber-400 hover:text-amber-600 dark:hover:text-amber-300 transition-colors duration-200">
                △ OoTR Async Weekly
            </a>
            <div class="flex items-center gap-6">
                <a href="/archives" class="font-cinzel text-xs tracking-widest uppercase text-stone-500 dark:text-gray-400 hover:text-amber-700 dark:hover:text-amber-400 transition-colors duration-200">
                    Archives
                </a>
                <span class="font-cinzel text-xs tracking-widest uppercase text-amber-600 dark:text-amber-400 border-b border-amber-400 dark:border-amber-600 pb-px">
                    Rulesets
                </span>
                <a href="/upcoming" class="font-cinzel text-xs tracking-widest uppercase text-stone-500 dark:text-gray-400 hover:text-amber-700 dark:hover:text-amber-400 transition-colors duration-200">
                    Upcoming
                </a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto mt-10 px-4 pb-16 max-w-3xl">

        <h1 class="font-cinzel text-4xl font-bold text-center tracking-wider mb-2 text-amber-700 dark:text-amber-400">
            Rulesets
        </h1>
        <p class="text-center text-xs mb-8 tracking-widest font-cinzel text-stone-400 dark:text-gray-600">
            Available presets &amp; their draw probabilities
        </p>
        <div class="gold-line max-w-xs mx-auto mb-10"></div>

        <% if (leaderboards && leaderboards.length > 0) { %>

        <%
            const badgeLight = { s9: 'bg-amber-100 text-amber-800 border-amber-300', tot: 'bg-purple-100 text-purple-800 border-purple-300', mixed: 'bg-emerald-100 text-emerald-800 border-emerald-300', rsl: 'bg-red-100 text-red-800 border-red-300', franco_easy: 'bg-teal-100 text-teal-800 border-teal-300', franco_hard: 'bg-orange-100 text-orange-800 border-orange-300' };
            const badgeDark  = { s9: 'dark:bg-amber-900/50 dark:text-amber-300 dark:border-amber-700/50', tot: 'dark:bg-purple-900/50 dark:text-purple-300 dark:border-purple-700/50', mixed: 'dark:bg-emerald-900/50 dark:text-emerald-300 dark:border-emerald-700/50', rsl: 'dark:bg-red-900/50 dark:text-red-300 dark:border-red-700/50', franco_easy: 'dark:bg-teal-900/50 dark:text-teal-300 dark:border-teal-700/50', franco_hard: 'dark:bg-orange-900/50 dark:text-orange-300 dark:border-orange-700/50' };
            const barColor   = { s9: 'bg-amber-400 dark:bg-amber-500', tot: 'bg-purple-400 dark:bg-purple-500', mixed: 'bg-emerald-400 dark:bg-emerald-500', rsl: 'bg-red-400 dark:bg-red-500', franco_easy: 'bg-teal-400 dark:bg-teal-500', franco_hard: 'bg-orange-400 dark:bg-orange-500' };
            const multiLb = leaderboards.length > 1;
        %>

        <% if (multiLb) { %>
        <!-- Tab buttons -->
        <div class="flex gap-2 mb-6 overflow-x-auto pb-1">
            <% leaderboards.forEach((lb, i) => { %>
            <button
                id="tab-btn-<%= lb.id %>"
                onclick="switchTab(<%= lb.id %>)"
                class="font-cinzel text-xs tracking-widest uppercase px-5 py-2 rounded-full border transition-colors duration-200 whitespace-nowrap
                       <%= i === 0 ? 'bg-amber-600 dark:bg-amber-500 text-white border-amber-600 dark:border-amber-500' : 'bg-transparent text-stone-500 dark:text-gray-400 border-stone-200 dark:border-gray-700 hover:border-amber-400 dark:hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400' %>">
                <%= lb.name %>
            </button>
            <% }) %>
        </div>
        <% } %>

        <!-- Tab panels -->
        <% leaderboards.forEach((lb, lbIdx) => { %>
        <div id="panel-<%= lb.id %>" class="<%= multiLb && lbIdx > 0 ? 'hidden' : '' %>">

            <% if (!multiLb && lb.name) { %>
            <h2 class="font-cinzel text-lg font-semibold text-amber-700 dark:text-amber-400 mb-4 tracking-wide">
                <%= lb.name %>
            </h2>
            <% } %>

            <div class="space-y-4">
            <% lb.rulesets.forEach(ruleset => { %>
            <%
                const key = ruleset.key.replace('seed_', '');
                const bl = badgeLight[key] || 'bg-blue-100 text-blue-800 border-blue-300';
                const bd = badgeDark[key]  || 'dark:bg-blue-900/50 dark:text-blue-300 dark:border-blue-700/50';
                const bar = barColor[key]  || 'bg-blue-400 dark:bg-blue-500';
            %>
            <div class="bg-white/80 dark:bg-gray-900/70 border border-amber-200 dark:border-amber-800/20 rounded-xl p-6 shadow-sm transition-colors duration-300">
                <div class="flex items-center justify-between mb-3">
                    <span class="font-cinzel text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded border
                                 <%= bl %> <%= bd %>">
                        <%= ruleset.name %>
                    </span>
                    <span class="font-cinzel text-2xl font-bold text-amber-600 dark:text-amber-300">
                        <%= ruleset.probability %>%
                    </span>
                </div>
                <p class="text-sm text-stone-600 dark:text-gray-400 mb-4 leading-relaxed">
                    <%= ruleset.description %>
                </p>
                <div class="w-full h-1.5 rounded-full bg-stone-100 dark:bg-gray-800 overflow-hidden">
                    <div class="h-full rounded-full <%= bar %> transition-all duration-500"
                         style="width: <%= ruleset.probability %>%"></div>
                </div>
            </div>
            <% }) %>
            </div>

        </div>
        <% }) %>

        <div class="mt-10 p-4 rounded-lg border text-xs text-center font-cinzel tracking-widest
                    bg-amber-50 dark:bg-amber-950/20
                    border-amber-200 dark:border-amber-800/30
                    text-stone-400 dark:text-gray-600">
            A new preset is drawn automatically each week using weighted random selection.
        </div>

        <% } else { %>
        <div class="text-center py-24 font-cinzel">
            <p class="text-xl tracking-wide text-stone-400 dark:text-gray-600">No leaderboard configured yet.</p>
        </div>
        <% } %>

    </main>

    <footer class="mt-4 pb-8 text-center">
        <div class="gold-line max-w-xs mx-auto mb-6"></div>
        <p class="font-cinzel text-xs tracking-widest uppercase text-stone-300 dark:text-gray-700">
            &copy; 2026 OoT Randomizer Async Weekly
        </p>
    </footer>

    <% if (leaderboards && leaderboards.length > 1) { %>
    <div id="__rulesets_cfg__" hidden
         data-lb-ids="<%= leaderboards.map(lb => lb.id).join(',') %>">
    </div>
    <script>
        const cfg = document.getElementById('__rulesets_cfg__').dataset;
        const lbIds = cfg.lbIds ? cfg.lbIds.split(',').map(Number) : [];
        const STORAGE_KEY = 'ootAsyncRulesetsLb';

        const BASE = 'font-cinzel text-xs tracking-widest uppercase px-5 py-2 rounded-full border transition-colors duration-200 whitespace-nowrap';
        const ACTIVE = 'bg-amber-600 dark:bg-amber-500 text-white border-amber-600 dark:border-amber-500';
        const INACTIVE = 'bg-transparent text-stone-500 dark:text-gray-400 border-stone-200 dark:border-gray-700 hover:border-amber-400 dark:hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400';

        function switchTab(id) {
            lbIds.forEach(function(lbId) {
                const panel = document.getElementById('panel-' + lbId);
                const btn = document.getElementById('tab-btn-' + lbId);
                if (!panel || !btn) return;
                const active = lbId === id;
                panel.classList.toggle('hidden', !active);
                btn.className = BASE + ' ' + (active ? ACTIVE : INACTIVE);
            });
            try { sessionStorage.setItem(STORAGE_KEY, String(id)); } catch(e) {}
        }

        (function() {
            var saved = null;
            try { saved = sessionStorage.getItem(STORAGE_KEY); } catch(e) {}
            var id = saved ? parseInt(saved, 10) : lbIds[0];
            if (lbIds.includes(id)) switchTab(id);
        })();
    </script>
    <% } %>

</body>
</html>
