<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OoT Randomizer Async Weekly</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            color-scheme: light dark;
        }

        body {
            @apply bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100;
        }
    </style>
</head>

<body class="min-h-screen font-sans bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <nav class="bg-gray-100 dark:bg-gray-800 p-4 shadow-lg">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-xl font-bold text-green-600 dark:text-green-400">OoTR Async Weekly</a>
            <div>
                <a href="/archives"
                    class="text-gray-600 dark:text-gray-300 hover:text-black dark:hover:text-white mx-2">Archives</a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto mt-8 px-4">
        <% if (seed) { %>
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-xl border border-gray-200 dark:border-gray-700">
                <h1 class="text-3xl font-bold mb-4 text-center">Weekly Seed</h1>
                <div class="flex flex-col md:flex-row justify-around items-center mb-8 gap-4">
                    <div class="text-center">
                        <span class="block text-gray-500 dark:text-gray-400 uppercase text-xs">Preset</span>
                        <span class="text-2xl font-semibold text-green-600 dark:text-green-400">
                            <%= seed.preset.replace('seed_', '' ).toUpperCase() %>
                        </span>
                    </div>
                    <div class="text-center">
                        <span class="block text-gray-500 dark:text-gray-400 uppercase text-xs">Version</span>
                        <span class="text-2xl font-semibold">
                            <%= seed.version %>
                        </span>
                    </div>
                    <div class="text-center">
                        <span class="block text-gray-500 dark:text-gray-400 uppercase text-xs">Generated at</span>
                        <span class="text-2xl font-semibold">
                            <%= new Date(seed.createdAt).toLocaleString('en-GB', { timeZone: 'Europe/Paris' ,
                                weekday: 'long' , day: '2-digit' , month: 'long' , year: 'numeric' , hour: '2-digit' ,
                                minute: '2-digit' }) %>
                        </span>
                    </div>
                    <div class="text-center">
                        <a href="<%= seed.seedUrl %>" target="_blank"
                            class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-full transition duration-300 shadow-lg">
                            Download Seed
                        </a>
                    </div>
                </div>

                <div class="mt-12">
                    <h2 class="text-2xl font-bold mb-4 border-b border-gray-200 dark:border-gray-700 pb-2">Submit my
                        time</h2>
                    <form action="/score" method="POST" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <input type="text" name="playerName" placeholder="Player name" required
                            class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded p-2 focus:outline-none focus:border-green-500 text-gray-900 dark:text-white">
                        <input type="text" name="time" placeholder="Time (ex: 2:45:12 or ff)"
                            class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded p-2 focus:outline-none focus:border-green-500 text-gray-900 dark:text-white">
                        <input type="text" name="vodUrl" placeholder="VOD Link (optional)"
                            class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded p-2 focus:outline-none focus:border-green-500 text-gray-900 dark:text-white">
                        <input type="text" name="comment" placeholder="Comment (optional)"
                            class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded p-2 focus:outline-none focus:border-green-500 text-gray-900 dark:text-white">
                        <button type="submit"
                            class="lg:col-span-4 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded transition duration-300">
                            Submit Time
                        </button>
                    </form>
                </div>

                <div class="mt-12">
                    <details class="group">
                        <summary
                            class="list-none cursor-pointer bg-gray-100 dark:bg-gray-700 p-4 rounded-lg flex justify-between items-center group-open:rounded-b-none transition-all duration-300">
                            <span class="text-xl font-bold">Weekly Standings</span>
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor"
                                    stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    viewBox="0 0 24 24" width="24">
                                    <path d="M6 9l6 6 6-6"></path>
                                </svg>
                            </span>
                        </summary>
                        <div
                            class="bg-white dark:bg-gray-800 border border-t-0 border-gray-200 dark:border-gray-700 p-4 rounded-b-lg overflow-x-auto">
                            <table class="w-full text-left">
                                <thead>
                                    <tr
                                        class="text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                                        <th class="py-2 px-4">Rank</th>
                                        <th class="py-2 px-4">Player</th>
                                        <th class="py-2 px-4 text-right">Time</th>
                                        <th class="py-2 px-4 text-center">VOD</th>
                                        <th class="py-2 px-4">Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (seed.scores && seed.scores.length > 0) { %>
                                        <% let rank = 0; %>
                                        <% seed.scores.forEach((score) => { %>
                                            <% if (score.time !== null) rank++; %>
                                            <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                                                <td class="py-3 px-4">
                                                    <%= score.time === null ? '-' : rank %>
                                                </td>
                                                <td class="py-3 px-4 font-semibold text-green-600 dark:text-green-300">
                                                    <%= score.playerName %>
                                                </td>
                                                <td class="py-3 px-4 text-right font-mono <%= score.time === null ? 'text-red-500 italic' : '' %>">
                                                    <%= formatTime(score.time) %>
                                                </td>
                                                <td class="py-3 px-4 text-center">
                                                    <% if (score.vodUrl) { %>
                                                        <a href="<%= score.vodUrl %>" target="_blank"
                                                            class="text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">
                                                            <svg class="w-5 h-5 inline" fill="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path
                                                                    d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 .61 0 1.3-.1 2.1-.06.8-.15 1.43-.28 1.9-.13.47-.45.85-.94 1.14-.49.28-1.23.42-2.22.42-1 0-1.83-.02-2.5-.07-.66-.04-1.3-.1-1.92-.16-.62-.06-1.12-.12-1.5-.18-.38-.06-.8-.1-1.26-.1l-1.28.1c-.46 0-.88.04-1.26.1-.38.06-.88.12-1.5.18-.62.06-1.26.12-1.92.16-.66.05-1.5.07-2.5.07-.99 0-1.73-.14-2.22-.42-.49-.29-.81-.67-.94-1.14-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-.61 0-1.3.1-2.1.06-.8.15-1.43.28-1.9.13-.47.45-.85.94-1.14.49-.28 1.23-.42 2.22-.42 1 0 1.83.02 2.5.07.66.04 1.3.1 1.92.16.62.06 1.12.12 1.5.18.38.06.8.1 1.26.1l1.28-.1c.46 0 .88-.04 1.26-.1.38-.06.88-.12 1.5-.18.62-.06 1.26-.12 1.92-.16.66-.05 1.5-.07 2.5-.07.99 0 1.73.14 2.22.42.49.29.81.67.94 1.14z" />
                                                            </svg>
                                                        </a>
                                                    <% } else { %>
                                                        <span class="text-gray-300 dark:text-gray-600">-</span>
                                                    <% } %>
                                                </td>
                                                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400 italic">
                                                    <%= score.comment || '-' %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="py-8 text-center text-gray-500 italic">No
                                                times recorded yet. Be the first!</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
            <% } else { %>
                <div
                    class="text-center p-12 bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700">
                    <p class="text-xl">No active seed at the moment. Come back later!</p>
                </div>
                <% } %>
    </main>

    <footer class="mt-12 p-8 text-center text-gray-500 dark:text-gray-400 text-sm">
        &copy; 2026 OoT Randomizer Async Weekly - Powered by the community.
    </footer>
</body>

</html>