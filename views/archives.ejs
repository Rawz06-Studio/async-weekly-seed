<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archives – OoT Randomizer Async Weekly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'media',
            theme: { extend: { fontFamily: { cinzel: ['Cinzel', 'serif'] } } }
        }
    </script>
    <style>
        :root {
            --body-bg: #faf7f0;
            --body-glow: radial-gradient(ellipse 80% 40% at 50% -5%, #fef3c7 0%, transparent 70%);
            --gold-stop: rgba(180, 83, 9, 0.45);
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --body-bg: #0d0e1a;
                --body-glow: radial-gradient(ellipse 80% 40% at 50% -5%, #1e1040 0%, transparent 70%);
                --gold-stop: rgba(217, 119, 6, 0.5);
            }
        }
        body { background-color: var(--body-bg); background-image: var(--body-glow); }
        .gold-line {
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold-stop), transparent);
        }
    </style>
</head>

<body class="min-h-screen font-sans text-gray-900 dark:text-gray-100 transition-colors duration-300">

    <nav class="sticky top-0 z-10 backdrop-blur-md bg-amber-50/80 dark:bg-black/50 border-b border-amber-200 dark:border-amber-800/30 transition-colors duration-300">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="font-cinzel text-xl font-bold tracking-widest text-amber-700 dark:text-amber-400 hover:text-amber-600 dark:hover:text-amber-300 transition-colors duration-200">
                △ OoTR Async Weekly
            </a>
            <div class="flex items-center gap-6">
                <span class="font-cinzel text-xs tracking-widest uppercase text-amber-600 dark:text-amber-400 border-b border-amber-400 dark:border-amber-600 pb-px">
                    Archives
                </span>
                <a href="/rulesets" class="font-cinzel text-xs tracking-widest uppercase text-stone-500 dark:text-gray-400 hover:text-amber-700 dark:hover:text-amber-400 transition-colors duration-200">
                    Rulesets
                </a>
                <a href="/upcoming" class="font-cinzel text-xs tracking-widest uppercase text-stone-500 dark:text-gray-400 hover:text-amber-700 dark:hover:text-amber-400 transition-colors duration-200">
                    Upcoming
                </a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto mt-10 px-4 pb-16">

        <h1 class="font-cinzel text-4xl font-bold text-center tracking-wider mb-2 text-amber-700 dark:text-amber-400">
            Archives
        </h1>
        <p class="text-center text-xs mb-8 tracking-widest font-cinzel text-stone-400 dark:text-gray-600">
            Past weekly seeds & standings
        </p>
        <div class="gold-line max-w-xs mx-auto mb-10"></div>

        <% if (archives && archives.length > 0) { %>
        <%
            const allPresets = [...new Set(archives.map(s => s.preset.replace('seed_', '')))];
        %>

        <%/* ── Filters bar ──────────────────────────────────────────── */%>
        <div class="flex flex-wrap items-center justify-center gap-3 mb-8">

            <%/* Preset filters (only when 2+ presets) */%>
            <% if (allPresets.length > 1) { %>
            <div class="flex flex-wrap gap-2">
                <button id="filter-all" onclick="filterPreset('all')"
                    class="font-cinzel text-xs uppercase tracking-widest px-4 py-2 rounded-lg border transition-all duration-200">
                    All
                </button>
                <% allPresets.forEach(p => { %>
                <button id="filter-<%= p %>" onclick="filterPreset('<%= p %>')"
                    class="font-cinzel text-xs uppercase tracking-widest px-4 py-2 rounded-lg border transition-all duration-200">
                    <%= p %>
                </button>
                <% }) %>
            </div>
            <div class="w-px h-5 bg-stone-300 dark:bg-gray-700 self-center hidden sm:block"></div>
            <% } %>

            <%/* Empty seeds toggle */%>
            <button id="toggle-empty" onclick="toggleEmpty()"
                class="flex items-center gap-1.5 font-cinzel text-xs uppercase tracking-widest px-4 py-2 rounded-lg border transition-all duration-200">
                <svg id="toggle-empty-icon" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                Hide empty
            </button>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% archives.forEach(seed => { %>
                <%
                    const presetKey = seed.preset.replace('seed_', '');
                    const badgeLight = { s9: 'bg-amber-100 text-amber-800 border-amber-300', tot: 'bg-purple-100 text-purple-800 border-purple-300', mixed: 'bg-emerald-100 text-emerald-800 border-emerald-300', rsl: 'bg-red-100 text-red-800 border-red-300' };
                    const badgeDark  = { s9: 'dark:bg-amber-900/50 dark:text-amber-300 dark:border-amber-700/50', tot: 'dark:bg-purple-900/50 dark:text-purple-300 dark:border-purple-700/50', mixed: 'dark:bg-emerald-900/50 dark:text-emerald-300 dark:border-emerald-700/50', rsl: 'dark:bg-red-900/50 dark:text-red-300 dark:border-red-700/50' };
                    const bl = badgeLight[presetKey] || 'bg-blue-100 text-blue-800 border-blue-300';
                    const bd = badgeDark[presetKey]  || 'dark:bg-blue-900/50 dark:text-blue-300 dark:border-blue-700/50';
                %>
                <a href="/archive/<%= seed.id %>" data-preset="<%= presetKey %>" data-count="<%= seed.scores.length %>"
                    class="group block
                           bg-white/80 dark:bg-gray-900/70
                           border border-amber-200 dark:border-amber-800/20
                           hover:border-amber-400 dark:hover:border-amber-600/50
                           rounded-xl p-6 shadow-sm hover:shadow-md hover:shadow-amber-100 dark:hover:shadow-amber-900/20
                           hover:-translate-y-0.5
                           transition-all duration-200">
                    <div class="flex justify-between items-start mb-4">
                        <span class="font-cinzel text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded border
                                     <%= bl %> <%= bd %> transition-colors duration-200">
                            <%= presetKey %>
                        </span>
                        <span class="text-xs font-cinzel text-stone-400 dark:text-gray-600">
                            <%= new Date(seed.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                    </div>
                    <div class="font-cinzel text-xl font-bold mb-2
                                text-gray-800 dark:text-gray-200
                                group-hover:text-amber-700 dark:group-hover:text-amber-300
                                transition-colors duration-200">
                        Seed #<%= seed.id %>
                    </div>
                    <div class="text-sm mb-5 text-stone-400 dark:text-gray-600">
                        <%= seed.scores.length %> participant<%= seed.scores.length !== 1 ? 's' : '' %>
                    </div>
                    <div class="gold-line"></div>
                    <div class="mt-4 font-cinzel text-xs tracking-widest uppercase
                                text-amber-500 dark:text-amber-700
                                group-hover:text-amber-600 dark:group-hover:text-amber-500
                                transition-colors duration-200">
                        View standings →
                    </div>
                </a>
            <% }) %>
        </div>

        <div id="no-filter-results" class="hidden text-center py-16 font-cinzel">
            <p class="text-xl tracking-wide text-stone-400 dark:text-gray-600">No archives for this preset.</p>
        </div>

        <div id="__archives_cfg__" hidden data-presets="<%= allPresets.join(',') %>"></div>

        <% } else { %>
        <div class="text-center py-24 font-cinzel">
            <p class="text-xl tracking-wide text-stone-400 dark:text-gray-600">No archives yet.</p>
        </div>
        <% } %>

    </main>

    <script>
        const archivesCfg = document.getElementById('__archives_cfg__');
        const presetList = archivesCfg ? archivesCfg.dataset.presets.split(',').filter(Boolean) : [];

        let activePreset = 'all';
        let hideEmpty = true;

        function applyFilters() {
            document.querySelectorAll('[data-preset]').forEach(card => {
                const presetMatch = activePreset === 'all' || card.dataset.preset === activePreset;
                const countMatch = !hideEmpty || parseInt(card.dataset.count, 10) > 0;
                card.classList.toggle('hidden', !presetMatch || !countMatch);
            });
            const visible = document.querySelectorAll('[data-preset]:not(.hidden)').length;
            const noResults = document.getElementById('no-filter-results');
            if (noResults) noResults.classList.toggle('hidden', visible > 0);
        }

        function filterPreset(preset) {
            activePreset = preset;
            const activeClass = ['bg-amber-500', 'text-gray-900', 'border-amber-500'];
            const inactiveClass = ['border-amber-300', 'dark:border-amber-800/40', 'text-amber-600', 'dark:text-amber-700'];
            ['all', ...presetList].forEach(p => {
                const btn = document.getElementById('filter-' + p);
                if (!btn) return;
                const active = p === preset;
                activeClass.forEach(c => btn.classList.toggle(c, active));
                inactiveClass.forEach(c => btn.classList.toggle(c, !active));
            });
            applyFilters();
            try { localStorage.setItem('ootAsyncArchiveFilter', preset); } catch (_) {}
        }

        function toggleEmpty() {
            hideEmpty = !hideEmpty;
            const btn = document.getElementById('toggle-empty');
            const icon = document.getElementById('toggle-empty-icon');
            if (btn) {
                btn.classList.toggle('bg-stone-600', hideEmpty);
                btn.classList.toggle('dark:bg-gray-600', hideEmpty);
                btn.classList.toggle('text-white', hideEmpty);
                btn.classList.toggle('border-stone-600', hideEmpty);
                btn.classList.toggle('dark:border-gray-600', hideEmpty);
                btn.classList.toggle('border-stone-300', !hideEmpty);
                btn.classList.toggle('dark:border-gray-700', !hideEmpty);
                btn.classList.toggle('text-stone-500', !hideEmpty);
                btn.classList.toggle('dark:text-gray-500', !hideEmpty);
            }
            if (icon) icon.classList.toggle('opacity-0', !hideEmpty);
            applyFilters();
            try { localStorage.setItem('ootAsyncArchiveHideEmpty', hideEmpty ? '1' : '0'); } catch (_) {}
        }

        // Init preset filter
        let storedPreset = null;
        try { storedPreset = localStorage.getItem('ootAsyncArchiveFilter'); } catch (_) {}
        if (storedPreset && storedPreset !== 'all' && !presetList.includes(storedPreset)) {
            try { localStorage.removeItem('ootAsyncArchiveFilter'); } catch (_) {}
            storedPreset = null;
        }

        // Init empty toggle
        let storedHide = null;
        try { storedHide = localStorage.getItem('ootAsyncArchiveHideEmpty'); } catch (_) {}
        hideEmpty = storedHide === null ? true : storedHide === '1';

        // Apply initial state without triggering localStorage writes
        activePreset = storedPreset || 'all';
        filterPreset(activePreset);

        // Sync toggle button visual state
        const toggleBtn = document.getElementById('toggle-empty');
        const toggleIcon = document.getElementById('toggle-empty-icon');
        if (toggleBtn) {
            toggleBtn.classList.toggle('bg-stone-600', hideEmpty);
            toggleBtn.classList.toggle('dark:bg-gray-600', hideEmpty);
            toggleBtn.classList.toggle('text-white', hideEmpty);
            toggleBtn.classList.toggle('border-stone-600', hideEmpty);
            toggleBtn.classList.toggle('dark:border-gray-600', hideEmpty);
            toggleBtn.classList.toggle('border-stone-300', !hideEmpty);
            toggleBtn.classList.toggle('dark:border-gray-700', !hideEmpty);
            toggleBtn.classList.toggle('text-stone-500', !hideEmpty);
            toggleBtn.classList.toggle('dark:text-gray-500', !hideEmpty);
        }
        if (toggleIcon) toggleIcon.classList.toggle('opacity-0', !hideEmpty);
        applyFilters();
    </script>

    <footer class="mt-4 pb-8 text-center">
        <div class="gold-line max-w-xs mx-auto mb-6"></div>
        <p class="font-cinzel text-xs tracking-widest uppercase text-stone-300 dark:text-gray-700">
            &copy; 2026 OoT Randomizer Async Weekly
        </p>
    </footer>

</body>
</html>
