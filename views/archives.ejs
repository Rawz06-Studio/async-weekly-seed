<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archives - OoT Randomizer Async Weekly</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root { color-scheme: light dark; }
        body { @apply bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100; }
    </style>
</head>
<body class="min-h-screen font-sans bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <nav class="bg-gray-100 dark:bg-gray-800 p-4 shadow-lg">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-xl font-bold text-green-600 dark:text-green-400">OoTR Async Weekly</a>
            <div>
                <a href="/archives" class="text-white mx-2 font-bold underline">Archives</a>
            </div>
        </div>
    </nav>

    <main class="container mx-auto mt-8 px-4">
        <h1 class="text-3xl font-bold mb-8 text-center text-blue-600 dark:text-blue-400">Seed Archives</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (archives && archives.length > 0) { %>
                <% archives.forEach(seed => { %>
                    <a href="/archive/<%= seed.id %>" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:border-green-500 dark:hover:border-green-500 transition duration-300 block shadow-lg">
                        <div class="flex justify-between items-start mb-4">
                            <span class="bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded uppercase">
                                <%= seed.preset.replace('seed_', '') %>
                            </span>
                            <span class="text-gray-500 dark:text-gray-400 text-sm">
                                <%= new Date(seed.createdAt).toLocaleDateString('en-US') %>
                            </span>
                        </div>
                        <div class="text-xl font-bold mb-2">Seed #<%= seed.id %></div>
                        <div class="text-gray-600 dark:text-gray-400 text-sm">
                            <%= seed.scores.length %> participants
                        </div>
                        <div class="mt-4 text-green-600 dark:text-green-400 font-semibold text-sm">View standings &rarr;</div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center p-12 bg-white dark:bg-gray-800 rounded-lg text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700">
                    No archives yet.
                </div>
            <% } %>
        </div>
    </main>

    <footer class="mt-12 p-8 text-center text-gray-500 dark:text-gray-400 text-sm">
        &copy; 2026 OoT Randomizer Async Weekly
    </footer>
</body>
</html>
