DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=async_weekly_seed
PORT=3000

# Day of week for seed rotation (0=Sunday, 1=Monday, ..., 6=Saturday)
SEED_CHANGE_DAY=3

# Hour of day in Europe/Paris timezone (0-23)
SEED_CHANGE_HOUR=20

# Base URL of the seed generation API (without trailing slash)
SEED_API_URL=https://your-seed-api.example.com

# Number of upcoming presets to keep pre-drawn in the queue
PRESET_QUEUE_SIZE=5

# Public URL of the site shown in Discord notifications (optional, leave empty to omit)
APP_URL=https://async-weekly.rawz06.fr

# Comma-separated list of Discord webhook URLs to notify when a new seed is generated
# Leave empty to disable notifications
DISCORD_WEBHOOKS=
